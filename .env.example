# Copy to .env and fill in. Never commit .env.
# Synthetic data only. Not for clinical use.

# --- Local services ---
POSTGRES_USER=priorauth
POSTGRES_PASSWORD=priorauth_local
POSTGRES_DB=priorauth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
HAPI_PORT=8080
FHIR_BASE_URL=http://localhost:8080/fhir
PAYER_MOCK_URL=http://localhost:8090

# --- LLM: Azure OpenAI (primary) ---
LLM_PROVIDER=fake            # fake | azure | openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=

# --- LLM: OpenAI-compatible (secondary) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
EMBED_MODEL=

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=priorauth-agent
AZURE_MONITOR_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Agent runtime ---
CHECKPOINTER=sqlite                 # sqlite (local file in data/runtime) | postgres
WORKBENCH_SESSION_SECRET=           # set any long random string; blank = new per process
LLM_PRICE_INPUT_PER_1M=             # USD per 1M input tokens for cost estimates (blank = unknown)
LLM_PRICE_OUTPUT_PER_1M=

# --- Mock payer ---
PAYER_RANDOM_PEND_RATE=0            # 0..1 share of submissions pended first (async test)
PAYER_POLLS_UNTIL_FINAL=2
